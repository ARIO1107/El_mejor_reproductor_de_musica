<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#181414"
    android:padding="16dp">

    <!-- Header Container: Large Album Art and Track Meta -->
    <RelativeLayout
        android:id="@+id/expanded_header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Large Album Art -->
        <ImageView
            android:id="@+id/notification_expanded_art"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher_background" />

        <!-- Close X Button Top-Right -->
        <ImageButton
            android:id="@+id/notification_expanded_btn_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_notif_close"
            android:contentDescription="Eliminar notificación" />

        <!-- Track Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/notification_expanded_art"
            android:layout_toStartOf="@id/notification_expanded_btn_close"
            android:layout_marginStart="16dp"
            android:layout_alignParentTop="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notification_expanded_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Título de la canción"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/notification_expanded_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Artista"
                android:textColor="#B0BEC5"
                android:textSize="13sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/notification_expanded_album"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Álbum"
                android:textColor="#78909C"
                android:textSize="11sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Progress Track Section -->
    <RelativeLayout
        android:id="@+id/progress_expanded_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/expanded_header_container"
        android:layout_marginTop="14dp">

        <TextView
            android:id="@+id/notification_expanded_time_current"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:text="00:00"
            android:textColor="#90A4AE"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/notification_expanded_time_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="00:00"
            android:textColor="#90A4AE"
            android:textSize="11sp" />

        <ProgressBar
            android:id="@+id/notification_expanded_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/notification_expanded_time_current"
            android:layout_toStartOf="@id/notification_expanded_time_total"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#E91E63"
            android:progressBackgroundTint="#33FFFFFF" />
    </RelativeLayout>

    <!-- Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_below="@id/progress_expanded_container"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="5">

        <ImageButton
            android:id="@+id/notification_expanded_btn_like"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_notif_heart_off"
            android:contentDescription="Favorito" />

        <ImageButton
            android:id="@+id/notification_expanded_btn_prev"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_notif_prev"
            android:contentDescription="Anterior" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageButton
                android:id="@+id/notification_expanded_btn_play_pause"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_notif_play_btn"
                android:src="@drawable/ic_notif_play"
                android:contentDescription="Reproducir / Pausa" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/notification_expanded_btn_next"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_notif_next"
            android:contentDescription="Siguiente" />

        <ImageButton
            android:id="@+id/notification_expanded_btn_mode"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_notif_mode_repeat"
            android:contentDescription="Modo de reproducción" />

    </LinearLayout>

</RelativeLayout>
