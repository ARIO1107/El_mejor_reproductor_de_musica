<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_card"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="REWIND 1137"
            android:textColor="@color/widget_accent"
            android:textSize="10sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/widget_bg_art"
                android:contentDescription="@null"
                android:padding="12dp"
                android:src="@drawable/ic_widget_music"
                android:tint="@color/widget_accent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="Rewind 1137"
                    android:textColor="@color/widget_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="Tu música, tu estilo"
                    android:textColor="@color/widget_subtext"
                    android:textSize="10sp" />

                <ProgressBar
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="6dp"
                    android:max="100"
                    android:progress="0"
                    android:progressBackgroundTint="@color/widget_pill"
                    android:progressTint="@color/widget_accent" />
            </LinearLayout>

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/widget_bg_btn_ghost"
                android:contentDescription="@null"
                android:padding="7dp"
                android:src="@drawable/ic_widget_heart"
                android:tint="@color/widget_heart_off" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/widget_bg_btn"
                android:contentDescription="@null"
                android:padding="8dp"
                android:src="@drawable/ic_widget_prev"
                android:tint="@color/widget_text" />

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/widget_bg_btn_primary"
                android:contentDescription="@null"
                android:padding="9dp"
                android:src="@drawable/ic_widget_play"
                android:tint="@color/widget_icon_on_primary" />

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/widget_bg_btn"
                android:contentDescription="@null"
                android:padding="8dp"
                android:src="@drawable/ic_widget_next"
                android:tint="@color/widget_text" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
